# Generate a stable 32-byte key for production with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_KEY=

# HTTP port and metadata cache lifetime in seconds.
PORT=7000
CACHE_TTL=3600

# Optional shared metadata cache. A bounded in-process cache is used without Redis.
# REDIS_URL=redis://default:password@redis-host:6379

# Persistent encrypted configurations. Mount /data in production.
# Install links do not expire; revoke access in the configuration page.
CONFIG_DB_PATH=/data/youtubio.sqlite

# Optional private instance: one shared password grants revocable access tokens.
# Set both values; use a unique password of at least 16 characters.
# PRIVATE_MODE=1
# PRIVATE_MODE_PASSWORD=

# Public hostname without a protocol, used in the startup configuration URL.
SPACE_HOST=https://youtubio.app.home.arpa

# Limit yt-dlp to specific extractors. Defaults to all extractors.
# YTDLP_EXTRACTORS=all

# Enable redacted Fastify debug logs and use main-branch assets.
# DEV_LOGGING=1

# Disable the corresponding optional integrations.
# NO_DEARROW=1
# NO_SPONSORBLOCK=1

# Trusted HTML injected into the configuration page.
# EMBED=
# YTDLP_EXTRACTORS_EMBED=
